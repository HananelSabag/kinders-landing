# העתיקו ל-.env.local לפיתוח, והגדירו את אותם משתנים ב-Vercel → Settings → Environment Variables

# איך כפתור התרומה עובד:
#   whatsapp (ברירת מחדל): מעביר לוואטסאפ של העמותה עם הודעה מוכנה
#   mock: לפיתוח, מדמה תשלום ומעביר ל-/thank-you
#   link: מעביר לדף תשלום קבוע של ספק הסליקה (דורש PAYMENT_LINK_URL)
#   grow: יוצר תשלום ב-Grow דרך ה-API. עוד לא פעיל, ראו docs/08-payments-grow.md
PAYMENT_PROVIDER=whatsapp
PAYMENT_LINK_URL=

# הכתובת הסופית של האתר (ל-sitemap ול-robots), למשל https://kinders.org.il
NEXT_PUBLIC_SITE_URL=

# Grow (כשיהיה חשבון). ב-Sandbox: GROW_API_URL=https://sandbox.meshulam.co.il
# GROW_API_URL=
# GROW_USER_ID=
# GROW_PAGE_CODE=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
